    return nil
end

function Module.cleanEffectName(rawName)
    local exact = EXACT_EFFECT_METADATA[rawName]
    if exact and exact.DisplayName then
        return exact.DisplayName
    end

    local name = rawName:gsub("^_hitEffect", ""):gsub("^_spawnEffect", ""):gsub("^_killEffect", ""):gsub("^SpawnEffect", ""):gsub("^HitEffect", "")
    name = name:gsub("(%l)(%u)", "%1 %2")
    return name
end

function Module.getEffectRarity(rawName)
    local exact = EXACT_EFFECT_METADATA[rawName]
    if exact then
        return "Mythical"
    end
    return RARITY_MAP[rawName] or "Rare"
end

function Module.getRarityHex(rarity)
    local r = RARITY[rarity] or RARITY.Unknown
    return r.Hex
end

function Module.getEffectImage(id)
    return EFFECT_TEXTURE_MAP[id] or "rbxassetid://10849912178"
end

local function sortCatalog(list)
    table_sort(list, function(a, b)
        local rankA = (RARITY[a.Rarity] or RARITY.Unknown).Rank
        local rankB = (RARITY[b.Rarity] or RARITY.Unknown).Rank
        if rankA ~= rankB then
            return rankA < rankB
        end
        return a.Name < b.Name
    end)
end

local function addDisplayEntry(entry, displayStrings, lookup)
    local hex = Module.getRarityHex(entry.Rarity)
    local displayStr = string.format("<font color=\"%s\">[%s]</font> %s", hex, entry.Rarity, entry.Name)
    local plainStr = string.format("[%s] %s", entry.Rarity, entry.Name)
    entry.DisplayString = displayStr
    entry.Image = Module.getEffectImage(entry.ItemID)
    table_insert(displayStrings, displayStr)
    lookup[displayStr] = entry
    lookup[plainStr] = entry
    lookup[entry.Name] = entry
    lookup[entry.ItemID] = entry
    Controller.DisplayToEntryMap[displayStr] = entry
    Controller.DisplayToEntryMap[plainStr] = entry
    Controller.DisplayToEntryMap[entry.Name] = entry
    Controller.DisplayToEntryMap[entry.ItemID] = entry
end

function Module.rebuildDisplayStrings(force)
    if not force and not displayDirty then
        return false
    end

    if force then
        dirtyCategories.Hit = true
        dirtyCategories.Spawn = true
        dirtyCategories.Kill = true
    end

    if dirtyCategories.Hit then
        sortCatalog(Controller.CatalogHit)
        table.clear(Controller.HitDisplayStrings)
        table.clear(Controller.HitDisplayLookup)
        for _, entry in ipairs(Controller.CatalogHit) do
            addDisplayEntry(entry, Controller.HitDisplayStrings, Controller.HitDisplayLookup)
        end
        Controller.HitDisplayRevision = Controller.HitDisplayRevision + 1
    end

    if dirtyCategories.Spawn then
        sortCatalog(Controller.CatalogSpawn)
        table.clear(Controller.SpawnDisplayStrings)
        table.clear(Controller.SpawnDisplayLookup)
        for _, entry in ipairs(Controller.CatalogSpawn) do
            addDisplayEntry(entry, Controller.SpawnDisplayStrings, Controller.SpawnDisplayLookup)
        end
        Controller.SpawnDisplayRevision = Controller.SpawnDisplayRevision + 1
    end

    if dirtyCategories.Kill then
        sortCatalog(Controller.CatalogKill)
        table.clear(Controller.KillDisplayStrings)
        table.clear(Controller.KillDisplayLookup)
        for _, entry in ipairs(Controller.CatalogKill) do
            addDisplayEntry(entry, Controller.KillDisplayStrings, Controller.KillDisplayLookup)
        end
        Controller.KillDisplayRevision = Controller.KillDisplayRevision + 1
    end

    local defaultHit = Controller.CatalogByID["_hitEffectDefault"]
        or Controller.CatalogByID["_hitEffectDefaultReworked"]
    local defaultSpawn = Controller.CatalogByID["_spawnEffectDefault"]

    if not Controller.SelectedHitEffect and defaultHit then
        Controller.SelectedHitEffect = defaultHit
    end
    if not Controller.SelectedDeathEffect and defaultHit then
        Controller.SelectedDeathEffect = defaultHit
    end
    if not Controller.SelectedKillVisualEffect and defaultHit then
        Controller.SelectedKillVisualEffect = defaultHit
    end
    if not Controller.SelectedSpawnEffect and defaultSpawn then
        Controller.SelectedSpawnEffect = defaultSpawn
    end
    displayDirty = false
    dirtyCategories.Hit = false
    dirtyCategories.Spawn = false
    dirtyCategories.Kill = false
    Controller.CatalogRevision = Controller.CatalogRevision + 1
    return true
end

function Module.isDisplayDirty()
    return displayDirty
end

local function shouldReplaceSerialized(existing, candidate)
    if type(candidate) ~= "string" or candidate == "" or candidate == "nil" then return false end
    if type(existing) ~= "string" or existing == "" or existing == "nil" then return true end
    local candidateIsV2 = candidate:sub(1, 5) == "FXS2:"
    local existingIsV2 = existing:sub(1, 5) == "FXS2:"
    if candidateIsV2 and not existingIsV2 then return true end
    if not candidateIsV2 then return false end

    local function getVersion(value)
        local ok, document = pcall(HttpService.JSONDecode, HttpService, value:sub(6))
        return ok and type(document) == "table" and tonumber(document.Version) or 0
    end
    return getVersion(candidate) > getVersion(existing)
end

function Module.registerCatalogItem(category, id, name, rarity, instance, serialized)
    if category == "KillEffect" and not isAllowedSpecialKill(id) then
        return nil
    end

    if Controller.CatalogByID[id] then
        local entry = Controller.CatalogByID[id]
        local metadataChanged = false

        local exact = EXACT_EFFECT_METADATA[id]
        if exact then
            name = exact.DisplayName
            rarity = "Mythical"
        end

        if type(name) == "string" and name ~= "" and entry.Name ~= name then
            if Controller.CatalogByName[entry.Name] == entry then
                Controller.CatalogByName[entry.Name] = nil
            end
            entry.Name = name
            Controller.CatalogByName[name] = entry
            metadataChanged = true
        end

        if type(rarity) == "string" and rarity ~= "" and entry.Rarity ~= rarity then
            entry.Rarity = rarity
            entry.Rank = (RARITY[rarity] or RARITY.Unknown).Rank
            metadataChanged = true
        end

        mergeRouteSupport(entry, serialized, instance, category)
        if shouldReplaceSerialized(Controller.CloudCache[id], serialized) then
            Controller.CloudCache[id] = serialized
        end
        if instance then
            Controller.InstanceCache[id] = instance
        end

        if metadataChanged then
            displayDirty = true
            if entry.Category == "SpawnEffect" then
                dirtyCategories.Spawn = true
            elseif entry.Category == "KillEffect" then
                dirtyCategories.Kill = true
            else
                dirtyCategories.Hit = true
            end
        end
        return entry
    end

    local exact = EXACT_EFFECT_METADATA[id]
    if exact then
        name = exact.DisplayName
        rarity = "Mythical"
    end

    local entry = {
        Category = category,
        ItemID = id,
        Name = name,
        Rarity = rarity,
        Rank = (RARITY[rarity] or RARITY.Unknown).Rank,
        DisplayString = "",
        Image = Module.getEffectImage(id),
    }
    mergeRouteSupport(entry, serialized, instance, category)

    if category == "HitEffect" then
        table_insert(Controller.CatalogHit, entry)
    elseif category == "SpawnEffect" then
        table_insert(Controller.CatalogSpawn, entry)
    elseif category == "KillEffect" then
        table_insert(Controller.CatalogKill, entry)
    end

    Controller.CatalogByID[id] = entry
    Controller.CatalogByName[name] = entry

    if instance then
        Controller.InstanceCache[id] = instance
    end

    if shouldReplaceSerialized(Controller.CloudCache[id], serialized) then
        Controller.CloudCache[id] = serialized
    end

    displayDirty = true
    if category == "SpawnEffect" then
        dirtyCategories.Spawn = true
    elseif category == "KillEffect" then
        dirtyCategories.Kill = true
    else
        dirtyCategories.Hit = true
    end
    return entry
end

function Module.loadMasterDatabase()
    Module.registerCatalogItem("HitEffect", "_hitEffectTestingHack", "TestingHack", "Special")
    Module.registerCatalogItem("HitEffect", "_hitEffectTheParasite", "The Parasite", "Legendary")
    Module.registerCatalogItem("HitEffect", "_hitEffectBarzilPortalVortex", "Brazil Portal", "Rare")
    Module.registerCatalogItem("HitEffect", "_hitEffectBrainFog", "Brain Fog", "Rare")

    Module.registerCatalogItem("KillEffect", "_hitEffectStaffRave", "Staff Rave", "Special")
    Module.registerCatalogItem("KillEffect", "_hitEffectKittyKatastrophe", "Kitty Katastrophe", "Special")

    local function readLocal(path)
        if not hasFileSystem or not isfile(path) then return nil end
        local ok, raw = pcall(readfile, path)
        return ok and type(raw) == "string" and raw ~= "" and raw or nil
    end

    -- Keep the newest/base database from the project, then apply the 11 confirmed
    -- Mythicals as a surgical overlay. This avoids replacing newly added effects
    -- just because a corrected Mythical database is present.
    local content = readLocal("effects.txt") or readLocal("all_effects_master.json")
    if not content then
        local ok, res = pcall(function()
            return game:HttpGet(GITHUB_SECRET_URL .. "?t=" .. os.time())
        end)
        if ok and res and res ~= "" then content = res end
    end

    local correctedContent = readLocal("effects_CORRECTED_MYTHICS.txt")
    if (not content or content == "") and correctedContent then
        content = correctedContent
    end

    if not content or content == "" then
        Module.rebuildDisplayStrings(true)
        return false
    end

    local success, parsed = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not success or type(parsed) ~= "table" then
        Module.rebuildDisplayStrings(true)
        return false
    end

    local hitEffects = parsed.HitEffects or {}
    local spawnEffects = parsed.SpawnEffects or {}
    local killEffects = parsed.KillEffects or {}
    local metadata = parsed.EffectMetadata or {}
    local rarityMap = parsed.RarityMap or {}
    local displayNames = parsed.DisplayNames or {}

    -- Absolute fallback: an entry can exist in the dropdown but have no Serialized payload.
    -- In that case the old build showed "Effect unavailable". Fill those 11 payloads here.
    for id, exact in pairs(EXACT_EFFECT_METADATA) do
        local existingSerialized = serializedFromRawValue(hitEffects[id])
        if type(existingSerialized) ~= "string" or existingSerialized == "" or existingSerialized == "nil" then
            hitEffects[id] = EXACT_MYTHICAL_SERIALIZED[id]
        end
        metadata[id] = metadata[id] or {
            DisplayName = exact.DisplayName,
            Rarity = "Mythical",
            Category = "HitEffect",
        }
        rarityMap[id] = "Mythical"
        displayNames[id] = exact.DisplayName
    end

    if correctedContent and correctedContent ~= content then
        local okOverlay, overlay = pcall(HttpService.JSONDecode, HttpService, correctedContent)
        if okOverlay and type(overlay) == "table" then
            local overlayHit = overlay.HitEffects or {}
            local overlayMeta = overlay.EffectMetadata or {}
            local overlayRarity = overlay.RarityMap or {}
            local overlayNames = overlay.DisplayNames or {}

            for id, exact in pairs(EXACT_EFFECT_METADATA) do
                local overlayValue = overlayHit[id]
                if overlayValue ~= nil then
                    local currentSerialized = serializedFromRawValue(hitEffects[id])
                    local currentIsV2 = type(currentSerialized) == "string"
                        and currentSerialized:sub(1, 5) == "FXS2:"
                    if not currentIsV2 then
                        hitEffects[id] = overlayValue
                    end
                end

                metadata[id] = overlayMeta[id] or metadata[id] or {
                    DisplayName = exact.DisplayName,
                    Rarity = "Mythical",
                    Category = "HitEffect",
                }
                rarityMap[id] = overlayRarity[id] or "Mythical"
                displayNames[id] = overlayNames[id] or exact.DisplayName
            end
        end
    end

    local function unpackEffect(id, rawVal)
        local serialized
        local name
        local rarity

        if type(rawVal) == "table" then
            serialized = rawVal.Serialized or rawVal.Data or rawVal.Effect
            name = rawVal.DisplayName or rawVal.Name
            rarity = rawVal.Rarity
        elseif type(rawVal) == "string" then
            serialized = rawVal
        end

        local meta = metadata[id]
        if type(meta) == "table" then
            name = meta.DisplayName or meta.Name or name
            rarity = meta.Rarity or rarity
        end

        name = displayNames[id] or name or Module.cleanEffectName(id)
        rarity = rarityMap[id] or rarity or Module.getEffectRarity(id)

        local exact = EXACT_EFFECT_METADATA[id]
        if exact then
            name = exact.DisplayName
            rarity = "Mythical"
        end

        return serialized, name, rarity
    end

    for id, rawVal in pairs(hitEffects) do
        local isStaff = (id == "_hitEffectStaffRave")
        local isKitty = (id == "_hitEffectKittyKatastrophe")
        local serialized, rName, rRarity = unpackEffect(id, rawVal)

        if isStaff or isKitty then
            local specialName = isStaff and "Staff Rave" or "Kitty Katastrophe"
            Module.registerCatalogItem("KillEffect", id, specialName, "Special", nil, serialized)
        else
            Module.registerCatalogItem("HitEffect", id, rName, rRarity, nil, serialized)
        end
    end

    for id, rawVal in pairs(spawnEffects) do
        if not id:lower():find("staffrave", 1, true) then
            local serialized, rName, rRarity = unpackEffect(id, rawVal)
            Module.registerCatalogItem("SpawnEffect", id, rName, rRarity, nil, serialized)
        end
    end

    for id, rawVal in pairs(killEffects) do
        if isAllowedSpecialKill(id) then
            local serialized = type(rawVal) == "table"
                and (rawVal.Serialized or rawVal.Data or rawVal.Effect)
                or rawVal
            local normalized = id:lower():gsub("[^%w]", "")
            local isStaff = normalized:find("staffrave", 1, true) ~= nil
            local specialName = isStaff and "Staff Rave" or "Kitty Katastrophe"
            Module.registerCatalogItem("KillEffect", id, specialName, "Special", nil, serialized)
        end
    end

    Module.rebuildDisplayStrings(true)
    return true
end
return Module
end)()

local Storage = (function()
local Module = { VERSION = 8 }

local Controller
local Serializer
local ReplicatedStorage
local ContentProvider
local hasFileSystem = false
local AssetsFolder
local HitFolder
local SpawnFolder
local failedSerialized = {}
local failedFileContents = {}

-- These aliases were previously captured from the all-in-one outer scope.
-- They MUST exist inside storage.luau when the module is loaded remotely.
local table_insert = table.insert
local task_wait = task.wait

local function refreshAssetFolders()
    if not AssetsFolder or AssetsFolder.Parent ~= ReplicatedStorage then
        AssetsFolder = ReplicatedStorage:FindFirstChild("Assets")
        HitFolder = nil
        SpawnFolder = nil
    end
    if AssetsFolder then
        if not HitFolder or HitFolder.Parent ~= AssetsFolder then
            HitFolder = AssetsFolder:FindFirstChild("HitEffects")
        end
        if not SpawnFolder or SpawnFolder.Parent ~= AssetsFolder then
            SpawnFolder = AssetsFolder:FindFirstChild("SpawnEffects")
        end
    end
    return HitFolder, SpawnFolder
end

function Module.Init(deps)
    assert(type(deps) == "table", "Storage.Init: deps table required")
    Controller = assert(deps.Controller, "Storage.Init: Controller required")
    Serializer = assert(deps.Serializer, "Storage.Init: Serializer required")
    ReplicatedStorage = deps.ReplicatedStorage or game:GetService("ReplicatedStorage")
    ContentProvider = deps.ContentProvider or game:GetService("ContentProvider")
    hasFileSystem = deps.hasFileSystem == true
    refreshAssetFolders()
    return Module
end

function Module.ensureEffectInstanceLoaded(entry)
    if not entry then return nil end
    local id = entry.ItemID
    local cached = Controller.InstanceCache[id]
    if cached then
        local valid = pcall(function() return cached.ClassName end)
        if valid then return cached end
        Controller.InstanceCache[id] = nil
    end

    local hitFolder, spawnFolder = refreshAssetFolders()
    local found = (hitFolder and hitFolder:FindFirstChild(id)) or (spawnFolder and spawnFolder:FindFirstChild(id))
    if found then
        Controller.InstanceCache[id] = found
        failedSerialized[id] = nil
        return found
    end

    local serialized = Controller.CloudCache[id]
    if serialized and failedSerialized[id] ~= serialized then
        local deserialized = Serializer.deserializeInstance(serialized)
        if deserialized then
            Controller.InstanceCache[id] = deserialized
            failedSerialized[id] = nil
            return deserialized
        end
        failedSerialized[id] = serialized
    end

    if hasFileSystem then
        local subDir = (entry.Category == "SpawnEffect") and "spawn" or "hit"
        local categoryPrefix = (entry.Category == "SpawnEffect") and "SpawnEffect" or "HitEffect"
        local candidates = {
            "effect/" .. subDir .. "/" .. id,
            "effect/" .. subDir .. "/" .. id .. ".txt",
            id,
            id .. ".txt",
        }

        for _, rarityName in ipairs({ "Mythical", "Legendary", "Epic", "Rare", "Uncommon", "Common", "Special" }) do
            local legacyName = categoryPrefix .. "__" .. rarityName .. "__" .. id .. ".txt"
            table_insert(candidates, legacyName)
            table_insert(candidates, "effect/" .. subDir .. "/" .. legacyName)
        end

        if type(listfiles) == "function" and type(isfolder) == "function" then
            local folderPath = "effect/" .. subDir
            if isfolder(folderPath) then
                local okList, files = pcall(listfiles, folderPath)
                if okList and type(files) == "table" then
                    for _, candidatePath in ipairs(files) do
                        local normalized = tostring(candidatePath):gsub("\\", "/")
                        local base = normalized:match("([^/]+)$") or normalized
                        if base:find(id, 1, true) then
                            table_insert(candidates, candidatePath)
                        end
                    end
                end
            end
        end

        local checked = {}
        for _, filePath in ipairs(candidates) do
            if not checked[filePath] then
                checked[filePath] = true
                if isfile(filePath) then
                    local ok, raw = pcall(readfile, filePath)
                    if ok and raw and raw ~= "" and failedFileContents[filePath] ~= raw then
                        local deserialized = Serializer.deserializeInstance(raw)
                        if deserialized then
                            Controller.InstanceCache[id] = deserialized
                            failedFileContents[filePath] = nil
                            return deserialized
                        end
                        failedFileContents[filePath] = raw
                    end
                end
            end
        end
    end

    return nil
end

function Module.preloadAssetsAsync(instances)
    if not instances or #instances == 0 then return false end

    -- Do NOT pass a whole 100-200 KB hierarchy to PreloadAsync in one shot.
    -- Collect only content-bearing Instances and preload them in small batches.
    local targets = {}
    local seen = setmetatable({}, { __mode = "k" })

    local function addTarget(instance)
        if not instance or seen[instance] then return end
        seen[instance] = true
        table_insert(targets, instance)
    end

    local function collect(root)
        if not root then return end
        local function consider(instance)
            if instance:IsA("ParticleEmitter")
                or instance:IsA("Beam")
                or instance:IsA("Trail")
                or instance:IsA("Sound")
                or instance:IsA("MeshPart")
                or instance:IsA("SpecialMesh")
                or instance:IsA("Decal")
                or instance:IsA("Texture")
                or instance:IsA("ImageLabel")
                or instance:IsA("ImageButton")
                or instance:IsA("SurfaceAppearance")
                or instance:IsA("VideoFrame")
            then
                addTarget(instance)
            end
        end

        consider(root)
        for index, descendant in ipairs(root:GetDescendants()) do
            consider(descendant)
            if index % 80 == 0 then task_wait() end
        end
    end

    for _, root in ipairs(instances) do
        collect(root)
    end

    if #targets == 0 then return true end

    local okAll = true
    local batchSize = 10
    for first = 1, #targets, batchSize do
        local batch = {}
        local last = math.min(first + batchSize - 1, #targets)
        for index = first, last do
            table_insert(batch, targets[index])
        end
        local ok = pcall(function()
            ContentProvider:PreloadAsync(batch)
        end)
        okAll = okAll and ok
        task_wait()
    end
    return okAll
end

function Module.purgeInactiveEffects()
    for id, inst in pairs(Controller.InstanceCache) do
        if not Controller.Selected or Controller.Selected.ItemID ~= id then
            if inst and inst.Parent == nil then
                pcall(inst.Destroy, inst)
                Controller.InstanceCache[id] = nil
                if Controller.PreloadedEffects then Controller.PreloadedEffects[id] = nil end
                if Controller.PreloadInFlight then Controller.PreloadInFlight[id] = nil end
            end
        end
    end
end
return Module
end)()

