local function setElementVisible(elem, visible)
    if not elem then return end
    pcall(function()
        if typeof(elem) == "Instance" then
            elem.Visible = visible
            return
        end
        if type(elem) == "table" then
            if elem.SetVisible then
                pcall(elem.SetVisible, elem, visible)
            end
            if elem.Show and elem.Hide then
                if visible then pcall(elem.Show, elem) else pcall(elem.Hide, elem) end
            end
            for _, k in ipairs({"Instance", "Frame", "Holder", "UI", "Object", "Button", "Root", "Container"}) do
                local obj = elem[k]
                if obj and typeof(obj) == "Instance" and obj:IsA("GuiObject") then
                    obj.Visible = visible
                end
            end
        end
    end)
end

local function onArenaEnter(expectedCharacter)
    local now = os.clock()
    if now - Controller.LastPortalEnterTime < 2.0 then return end
    if now - Controller.LastDeathTime < 3.5 then return end
    Controller.LastPortalEnterTime = now

    task_delay(0.12, function()
        if not Controller.ChangerActive or Controller.Destroyed then return end
        local char = LocalPlayer.Character
        if not char or (expectedCharacter and char ~= expectedCharacter) then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root then return end
        if now - (Controller.LastNativeSpawnEventTime or -math.huge) < 1 then return end
        local chosen = Controller.SelectedSpawnEffect
        if chosen and not isDefaultEntry(chosen, "Spawn") then
            local played = playSpawnEffectAction(chosen, char)
            if played then Controller.LastSpawnPlaybackTime = os.clock() end
        end
    end)
end

local function armArenaEntry()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root or not humanoid or humanoid.Health <= 0 then return end
    Controller.PendingArenaEntry = {
        Character = char,
        Origin = root.Position,
        TouchedAt = os.clock(),
    }
end

local function hookPortalDetector()
    local boundPortals = setmetatable({}, { __mode = "k" })
    local boundCount = 0

    local function isPortalPart(instance)
        if not instance or not instance:IsA("BasePart") then return false end
        local name = instance.Name:lower()
        return name:find("^teleport%d+$") ~= nil
            and not name:find("frame", 1, true)
            and not name:find("ramp", 1, true)
    end

    local function bindPortalTouch(portal)
        if not isPortalPart(portal) then return end
        if boundPortals[portal] then return end
        boundPortals[portal] = true
        boundCount = boundCount + 1
        local connection = portal.Touched:Connect(function(hit)
            if not Controller.ChangerActive or Controller.Destroyed then return end
            local character = LocalPlayer.Character
            if hit and character and hit:IsDescendantOf(character) then
                armArenaEntry()
            end
        end)
        table_insert(Controller.Connections, connection)
    end

    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then
        for _, descendant in ipairs(lobby:GetDescendants()) do
            bindPortalTouch(descendant)
        end
        table_insert(Controller.Connections, lobby.DescendantAdded:Connect(bindPortalTouch))
    end

    if boundCount == 0 then
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            bindPortalTouch(descendant)
        end
        table_insert(Controller.Connections, Workspace.DescendantAdded:Connect(bindPortalTouch))
    end

    local elapsedSinceCheck = 0
    local heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        elapsedSinceCheck = elapsedSinceCheck + deltaTime
        if elapsedSinceCheck < 0.08 then return end
        elapsedSinceCheck = 0
        if not Controller.ChangerActive or Controller.Destroyed then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local currentPos = hrp.Position
            local now = os.clock()
            local pending = Controller.PendingArenaEntry
            if pending then
                if pending.Character ~= char or now - pending.TouchedAt > 10 then
                    Controller.PendingArenaEntry = nil
                elseif now - Controller.LastDeathTime > 3.5 then
                    local movedFromPortal = (currentPos - pending.Origin).Magnitude > 150
                    local jumpedThisFrame = Controller.LastCharacterPosition
                        and (currentPos - Controller.LastCharacterPosition).Magnitude > 150
                    if movedFromPortal or jumpedThisFrame then
                        Controller.PendingArenaEntry = nil
                        onArenaEnter(char)
                    end
                end
            end
            if Controller.LastCharacterPosition then
                local fromX = Controller.LastCharacterPosition.X
                local toX = currentPos.X
                local dist = (currentPos - Controller.LastCharacterPosition).Magnitude
                if not pending and dist > 400 and fromX < -500 and toX > -400 and (now - Controller.LastPortalEnterTime > 3.0) and (now - Controller.LastDeathTime > 3.5) then
                    onArenaEnter(char)
                end
            end
            Controller.LastCharacterPosition = currentPos
        else
            Controller.LastCharacterPosition = nil
        end
    end)
    table_insert(Controller.Connections, heartbeatConnection)
end
task_spawn(hookPortalDetector)

local RecentSlaps = {}
local ProcessedDeaths = setmetatable({}, { __mode = "k" })
local DeathWatchStates = setmetatable({}, { __mode = "k" })
local PlayerWatchConnections = setmetatable({}, { __mode = "k" })
local KILL_WINDOW = 8.0
local SLAP_EVENT_DEDUPE = 0.18
local SlapSequence = 0

local function disconnectConnections(connections)
