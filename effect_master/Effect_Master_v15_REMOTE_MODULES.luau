local function resolveTargetPlayerAndChar(target, depth)
    if not target then return nil, nil end
    depth = depth or 0
    if depth > 2 then return nil, nil end
    local p, c
    if typeof(target) == "Instance" then
        if target:IsA("Player") then
            p = target
            c = target.Character
        elseif target:IsA("Model") then
            c = target
            p = Players:GetPlayerFromCharacter(c)
        elseif target:IsA("BasePart") then
            if target.Parent and target.Parent:IsA("Model") then
                c = target.Parent
                p = Players:GetPlayerFromCharacter(c)
            end
            if not p and target.Parent and target.Parent.Parent and target.Parent.Parent:IsA("Model") then
                c = target.Parent.Parent
                p = Players:GetPlayerFromCharacter(c)
            end
        end
    elseif type(target) == "number" then
        p = Players:GetPlayerByUserId(target)
        c = p and p.Character
    elseif type(target) == "string" then
        local userId = tonumber(target)
        if userId then
            p = Players:GetPlayerByUserId(userId)
        else
            p = Players:FindFirstChild(target)
            if not p then
                local lowerTarget = target:lower()
                for _, candidate in ipairs(Players:GetPlayers()) do
                    if candidate.Name:lower() == lowerTarget or candidate.DisplayName:lower() == lowerTarget then
                        p = candidate
                        break
                    end
                end
            end
        end
        c = p and p.Character
    elseif type(target) == "table" then
        local nested = target.player or target.Player or target.character or target.Character
            or target.target or target.Target or target.victim or target.Victim
            or target.userId or target.UserId
        if nested and nested ~= target then
            return resolveTargetPlayerAndChar(nested, depth + 1)
        end
    end
    return p, c
end

local function isLocalIdentity(value)
    if value == LocalPlayer or value == LocalPlayer.Character then return true end
    local player = resolveTargetPlayerAndChar(value)
    return player == LocalPlayer
end

local function recordSlap(victimTarget)
    local player, char = resolveTargetPlayerAndChar(victimTarget)
    if not player or player == LocalPlayer then return false end
    if not char then char = player.Character end
    if not char then return false end

    local now = os.clock()
    local previous = RecentSlaps[player]
    if previous and previous.Character == char and now - previous.Time < SLAP_EVENT_DEDUPE then
        return false
    end

    SlapSequence = SlapSequence + 1
    RecentSlaps[player] = {
        Time = now,
        Character = char,
        Sequence = SlapSequence,
    }
    return true
end

