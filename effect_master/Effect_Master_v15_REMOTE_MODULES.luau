local NativeVFXDecisions = setmetatable({}, { __mode = "k" })
local RecentRouteVisuals = setmetatable({}, { __mode = "k" })

local ROUTE_ENABLED_FIELD = {
    Hit = "HitEffectEnabled",
    Death = "DeathEffectEnabled",
    Kill = "KillVisualEnabled",
}

local function getOriginalEffectID(action, data)
    if type(data) ~= "table" then return nil end
    if action == "HitEffect" then
        return data.hitEffectID or data.HitEffectID or data.effectID or data.EffectID
    elseif action == "SpawnEffect" then
        return data.spawnEffectID or data.SpawnEffectID or data.effectID or data.EffectID
    end

    local effect = data.effect or data.Effect
    if typeof(effect) ~= "Instance" then return nil end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local hitEffects = assets and assets:FindFirstChild("HitEffects")
    local current = effect
    while current and current ~= hitEffects do
        if current.Parent == hitEffects then return current.Name end
        current = current.Parent
    end
    return nil
end

local function getKillOrDeathRoute(data)
    if type(data) ~= "table" then return nil end
    local target = data.targetPlayer or data.TargetPlayer or data.victim or data.Victim
        or data.target or data.Target
    local attacker = data.attacker or data.Attacker or data.killer or data.Killer
    if isLocalIdentity(target) then return "Death" end
    if isLocalIdentity(attacker) then return "Kill" end
    return nil
end

local function getRoutePlaybackTarget(route, data)
    if type(data) ~= "table" then return nil end

    local target
    if route == "Hit" then
        target = data.victim or data.Victim or data.target or data.Target or data.hit or data.Hit
            or data.hitPart or data.HitPart or data.victimUserId or data.VictimUserId
    elseif route == "Spawn" then
        target = data.spawnPosition or data.SpawnPosition or data.player or data.Player
            or data.targetPlayer or data.TargetPlayer
    else
        target = data.targetPlayer or data.TargetPlayer or data.victim or data.Victim
            or data.target or data.Target
    end

    local _, character = resolveTargetPlayerAndChar(target)
    return character or target
end

local function getReplacementDecision(route, data, originalID)
    local routeDecisions
    if type(data) == "table" then
        routeDecisions = NativeVFXDecisions[data]
        if not routeDecisions then
            routeDecisions = {}
            NativeVFXDecisions[data] = routeDecisions
        elseif routeDecisions[route] then
            return routeDecisions[route]
        end
    end

    local enabledField = ROUTE_ENABLED_FIELD[route]
    local enabled = route == "Spawn" or (enabledField and Controller[enabledField] ~= false)
    local chosen = route == "Spawn" and Controller.SelectedSpawnEffect or choosePlaybackEffect(route)
    local chosenID = getEntryID(chosen)
    local sameAsOriginal = normalizeEffectID(chosenID) ~= ""
        and normalizeEffectID(chosenID) == normalizeEffectID(originalID)
    local replace = Controller.ChangerActive
        and not Controller.Destroyed
        and enabled
        and chosen ~= nil
        and not sameAsOriginal

    -- Default is intentionally delegated to the game's own renderer. It has
    -- access to procedural details that no serialized fallback can improve.
    if replace and not originalID and isDefaultEntry(chosen, route) then
        replace = false
    end
    if replace then
        replace = VFX.canPlayEffect(chosen, route, false)
    end
    if replace and type(data) == "table" then
        local target = getRoutePlaybackTarget(route, data)
        replace = target ~= nil and getTargetCFrame(target) ~= nil
    end

    local decision = {
        Entry = chosen,
        OriginalID = originalID,
        Replace = replace == true,
    }
    if routeDecisions then routeDecisions[route] = decision end
    return decision
end

local function routeVisualTarget(target)
    local _, character = resolveTargetPlayerAndChar(target)
    if character then return character end
    if typeof(target) == "Instance" then return target end
    return LocalPlayer.Character
end

local function claimRouteVisual(route, target)
    local key = routeVisualTarget(target)
    if not key then return true end
    local state = RecentRouteVisuals[key]
    if not state then
        state = {}
        RecentRouteVisuals[key] = state
    end
    local now = os.clock()
    if now - (state[route] or -math.huge) < 0.45 then return false end
    state[route] = now
    return true
end

local function hasRecentRouteVisual(route, target)
    local key = routeVisualTarget(target)
    local state = key and RecentRouteVisuals[key]
    return state ~= nil and os.clock() - (state[route] or -math.huge) < 0.6
end

local function findNativePayload(handlerName, ...)
    for index = 1, select("#", ...) do
        local value = select(index, ...)
        if type(value) == "table" then
            if handlerName == "HitEffect" and (value.hitEffectID or value.HitEffectID or value.attacker or value.Attacker) then
                return value
            elseif handlerName == "SpawnEffect" and (value.spawnEffectID or value.SpawnEffectID or value.player or value.Player) then
                return value
            elseif handlerName == "PlayKillOrDeathEffect" and (value.effect or value.Effect or value.targetPlayer or value.TargetPlayer) then
                return value
            end
        end
    end
    return nil
end

local function isNativeDispatchTable(candidate)
    if type(candidate) ~= "table" then return false end
    local ok, result = pcall(function()
        return type(candidate.HitEffect) == "function"
            and type(candidate.SpawnEffect) == "function"
            and type(candidate.PlayKillOrDeathEffect) == "function"
    end)
    return ok and result == true
end

local function getConnectionCallback(connection)
    local callback
    pcall(function() callback = connection.Function end)
    if type(callback) ~= "function" then pcall(function() callback = connection.Callback end) end
    if type(callback) == "function" then return callback end

    local reader = getconnectionfunction or getcallbackvalue
    if type(reader) == "function" then
        pcall(function() callback = reader(connection) end)
        if type(callback) ~= "function" then
            pcall(function() callback = reader(connection, "Function") end)
        end
    end
    return type(callback) == "function" and callback or nil
end

local function findNativeDispatchTable(callback, getUpvaluesFn, seen, depth)
    if type(callback) ~= "function" or depth > 2 or seen[callback] then return nil end
    seen[callback] = true

    local okUpvalues, upvalues = pcall(getUpvaluesFn, callback)
    if not okUpvalues or type(upvalues) ~= "table" then return nil end
    for _, candidate in pairs(upvalues) do
        if isNativeDispatchTable(candidate) then return candidate end
        if type(candidate) == "table" and not seen[candidate] then
            seen[candidate] = true
            local nestedFound
            pcall(function()
                for _, nested in pairs(candidate) do
                    if isNativeDispatchTable(nested) then
                        nestedFound = nested
                        break
                    end
                    if type(nested) == "function" then
                        nestedFound = findNativeDispatchTable(nested, getUpvaluesFn, seen, depth + 1)
                        if nestedFound then break end
                    end
                end
            end)
            if nestedFound then return nestedFound end
        elseif type(candidate) == "function" then
            local found = findNativeDispatchTable(candidate, getUpvaluesFn, seen, depth + 1)
            if found then return found end
        end
    end
    return nil
end

local function installNativeVFXReplacement(VFXEvent)
    if Controller.NativeVFXReplacementReady or not VFXEvent then return Controller.NativeVFXReplacementReady end
    local getConnectionsFn = getconnections or get_signal_cons
    local getUpvaluesFn = getupvalues or (debug and debug.getupvalues)
    if type(getConnectionsFn) ~= "function" or type(getUpvaluesFn) ~= "function" then return false end

    local okConnections, connections = pcall(getConnectionsFn, VFXEvent.OnClientEvent)
    if not okConnections or type(connections) ~= "table" then return false end

    for _, connection in pairs(connections) do
        local callback = getConnectionCallback(connection)
        local dispatchTable = callback and findNativeDispatchTable(callback, getUpvaluesFn, {}, 0)
        if dispatchTable then
            local records = {}
            local patchFailed = false
            for _, name in ipairs({ "HitEffect", "SpawnEffect", "PlayKillOrDeathEffect" }) do
                local handlerName = name
                local originalHandler = dispatchTable[handlerName]
                local delegate = originalHandler
                local wrapper = function(...)
                    local payload = findNativePayload(handlerName, ...)
                    if payload and Controller.ChangerActive and not Controller.Destroyed then
                        local route = handlerName == "HitEffect" and "Hit"
                            or handlerName == "SpawnEffect" and "Spawn"
                            or getKillOrDeathRoute(payload)
                        if route then
                            local originalID = getOriginalEffectID(handlerName, payload)
                            local decision = getReplacementDecision(route, payload, originalID)
                            if decision.Replace then return nil end
                        end
                    end
                    return delegate(...)
                end

                local okSet = pcall(function() dispatchTable[handlerName] = wrapper end)
                if okSet and dispatchTable[handlerName] == wrapper then
                    records[#records + 1] = {
                        Kind = "Table",
                        Table = dispatchTable,
                        Name = handlerName,
                        Original = originalHandler,
                        Wrapper = wrapper,
                    }
                else
                    local hookFunction = hookfunction
                    local okHook, previous
                    if type(hookFunction) == "function" then
                        okHook, previous = pcall(hookFunction, originalHandler, wrapper)
                    end
                    if okHook and type(previous) == "function" then
                        delegate = previous
                        records[#records + 1] = {
                            Kind = "Hook",
                            Target = originalHandler,
                            Original = previous,
                        }
                    else
                        pcall(function()
                            if dispatchTable[handlerName] == wrapper then
                                dispatchTable[handlerName] = originalHandler
                            end
                        end)
                        patchFailed = true
                        break
                    end
                end
            end

            local function restoreRecords()
                for _, record in ipairs(records) do
                    if record.Kind == "Table" then
                        pcall(function()
                            if record.Table[record.Name] == record.Wrapper then
                                record.Table[record.Name] = record.Original
                            end
                        end)
                    elseif record.Kind == "Hook" and type(hookfunction) == "function" then
                        pcall(hookfunction, record.Target, record.Original)
                    end
                end
            end
            if patchFailed then
                restoreRecords()
            else
                Controller.NativeVFXReplacementReady = true
                Controller.RestoreNativeVFX = function()
                    restoreRecords()
                    Controller.NativeVFXReplacementReady = false
                    Controller.RestoreNativeVFX = nil
                end
                return true
            end
        end
    end
    return false
end

local function hookGameSlapAndDeathVFX()
    local eventsFolder = ReplicatedStorage:FindFirstChild("Events") or ReplicatedStorage:WaitForChild("Events", 10)
    local VFXEvent = eventsFolder and (eventsFolder:FindFirstChild("VFX") or eventsFolder:WaitForChild("VFX", 10))
    if VFXEvent then
        if not installNativeVFXReplacement(VFXEvent) then
            task_spawn(function()
                for _ = 1, 30 do
                    if Controller.Destroyed or installNativeVFXReplacement(VFXEvent) then return end
                    task_wait(0.1)
                end
            end)
        end
        local conn = VFXEvent.OnClientEvent:Connect(function(action, data)
            if type(action) == "string" and type(data) == "table" then
                if Controller.ChangerActive and not Controller.Destroyed then
                    local lowerAction = action:lower()
                    if lowerAction == "hiteffect" then
                        local attacker = data.attacker or data.Attacker or data.killer or data.Killer or data.source or data.Source
                            or data.attackerUserId or data.AttackerUserId
                        local victim = data.victim or data.Victim or data.target or data.Target or data.hit or data.Hit
                            or data.hitPart or data.HitPart or data.victimUserId or data.VictimUserId
                        local isAttackerMe = isLocalIdentity(attacker)
                        local isVictimMe = isLocalIdentity(victim)

                        if isVictimMe and not isAttackerMe then
                            Controller.LastIncomingHitTime = os.clock()
                            Controller.LastIncomingHitCharacter = LocalPlayer.Character
                        end

                        if isAttackerMe and not isVictimMe and victim and visualPlaybackAllowed() then
                            if recordSlap(victim) then
                                local decision = getReplacementDecision("Hit", data, getOriginalEffectID("HitEffect", data))
                                if decision.Replace and claimRouteVisual("Hit", victim) then
                                    playHitEffectOnCharacter(decision.Entry, victim, LocalPlayer)
                                end
                            end
                        end
                    elseif lowerAction == "spawneffect" then
                        local player = data.player or data.Player or data.targetPlayer or data.TargetPlayer
                        if isLocalIdentity(player) then
                            Controller.LastNativeSpawnEventTime = os.clock()
                            local decision = getReplacementDecision("Spawn", data, getOriginalEffectID("SpawnEffect", data))
                            if decision.Replace and visualPlaybackAllowed()
                                and os.clock() - (Controller.LastSpawnPlaybackTime or -math.huge) > 0.75 then
                                local target = getRoutePlaybackTarget("Spawn", data) or LocalPlayer.Character
                                if playSpawnEffectAction(decision.Entry, target) then
                                    Controller.LastSpawnPlaybackTime = os.clock()
                                end
                            else
                                Controller.LastSpawnPlaybackTime = os.clock()
                            end
                        end
                    elseif lowerAction == "playkillordeatheffect" then
                        local route = getKillOrDeathRoute(data)
                        local target = route and getRoutePlaybackTarget(route, data) or LocalPlayer.Character
                        if route and visualPlaybackAllowed() then
                            local decision = getReplacementDecision(route, data, getOriginalEffectID("PlayKillOrDeathEffect", data))
                            if decision.Replace and claimRouteVisual(route, target) then
                                playKillDeathEffectOnCharacter(decision.Entry, target, route == "Kill")
                            end
                        end
                    end
                end
            end
        end)
        table_insert(Controller.Connections, conn)
    end

    local function setupPlayerDeathWatch(player)
        local function onCharAdded(char)
            if RecentSlaps[player] and RecentSlaps[player].Character ~= char then
                RecentSlaps[player] = nil
            end

            clearDeathWatchState(player)
            local state = {
                Character = char,
                Humanoid = nil,
                Root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char:FindFirstChild("Torso"),
                Handled = false,
                Connections = {},
            }
            DeathWatchStates[player] = state

            local hum = char:WaitForChild("Humanoid", 5)
            if DeathWatchStates[player] ~= state then return end
            state.Humanoid = hum

            local function checkDeath(reason)
                if DeathWatchStates[player] ~= state or state.Handled then return end
                if not Controller.ChangerActive or Controller.Destroyed then return end

                if player == LocalPlayer then
                    local now = os.clock()
                    local combatDeath = Controller.LastIncomingHitCharacter == char
                        and now - (Controller.LastIncomingHitTime or -math.huge) <= KILL_WINDOW
                        and visualPlaybackAllowed()
                    state.Handled = true
                    Controller.LastDeathTime = now
                    Controller.LastCharacterPosition = nil
                    Controller.PendingArenaEntry = nil
                    table.clear(RecentSlaps)
                    suppressCharacterVisuals(1.5, not hasRecentRouteVisual("Death", char))
                    if combatDeath then
                        Controller.LastCombatDeathVisualTime = now
                        local decision = getReplacementDecision("Death", nil, nil)
                        if decision.Replace and claimRouteVisual("Death", char) then
                            local deathCF = getTargetCFrame(char)
                            playKillDeathEffectOnCharacter(decision.Entry, deathCF or char, false)
                        end
                    end
                    Controller.LastIncomingHitTime = -math.huge
                    Controller.LastIncomingHitCharacter = nil
                else
                    if ProcessedDeaths[char] then
                        state.Handled = true
                        return
                    end
                    local slap = RecentSlaps[player]
                    local now = os.clock()
                    local age = slap and (now - slap.Time) or math.huge
                    local sameCharacter = slap and (slap.Character == char)
                    local recent = slap and (age <= KILL_WINDOW)

                    if slap and sameCharacter and recent then
                        state.Handled = true
                        ProcessedDeaths[char] = true
                        RecentSlaps[player] = nil

                        if visualPlaybackAllowed() then
                            local deathCF = getTargetCFrame(char)
                            local decision = getReplacementDecision("Kill", nil, nil)
                            if decision.Replace and deathCF and claimRouteVisual("Kill", char) then
                                playKillDeathEffectOnCharacter(decision.Entry, deathCF or char, true)
                            end

                            local chosenKill = Controller.SelectedKillEffect
                            if Controller.KillEffectEnabled and chosenKill and playKillEffect then
                                playKillEffect(chosenKill, deathCF or char, LocalPlayer)
                            end
                        end
                    end
                end
            end
            state.CheckDeath = checkDeath

            if hum then
                local diedConnection = hum.Died:Connect(function() checkDeath("Humanoid.Died") end)
                local healthConnection = hum:GetPropertyChangedSignal("Health"):Connect(function()
                    if hum.Health <= 0 then
                        checkDeath("Health<=0")
                    end
                end)
                table_insert(state.Connections, diedConnection)
                table_insert(state.Connections, healthConnection)
            end

            local ancestryConnection = char.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    checkDeath("AncestryChanged")
                end
            end)
            table_insert(state.Connections, ancestryConnection)
        end

        if player.Character then
            task_spawn(onCharAdded, player.Character)
        end
        local addedConnection = player.CharacterAdded:Connect(onCharAdded)

        local removingConnection = player.CharacterRemoving:Connect(function(char)
            local state = DeathWatchStates[player]
            if state and state.Character == char and state.CheckDeath then
                state.CheckDeath("CharacterRemoving")
            end
            if player == LocalPlayer then
                local keepCombatDeath = os.clock() - (Controller.LastCombatDeathVisualTime or -math.huge) < 1.5
                table.clear(RecentSlaps)
                suppressCharacterVisuals(1.5, not keepCombatDeath)
                Controller.LastIncomingHitTime = -math.huge
                Controller.LastIncomingHitCharacter = nil
            end
            clearDeathWatchState(player)
        end)
        PlayerWatchConnections[player] = { addedConnection, removingConnection }
    end

    for _, p in ipairs(Players:GetPlayers()) do
        setupPlayerDeathWatch(p)
    end
    local playerAddedConnection = Players.PlayerAdded:Connect(setupPlayerDeathWatch)
    table_insert(Controller.Connections, playerAddedConnection)

    local playerRemovingConnection = Players.PlayerRemoving:Connect(function(p)
        RecentSlaps[p] = nil
        clearDeathWatchState(p)
        disconnectConnections(PlayerWatchConnections[p])
        PlayerWatchConnections[p] = nil
    end)
    table_insert(Controller.Connections, playerRemovingConnection)

    task_spawn(function()
        while not Controller.Destroyed do
            if Controller.ChangerActive then
                local now = os.clock()
                for player, state in pairs(DeathWatchStates) do
                    local slap = RecentSlaps[player]
                    if slap and now - slap.Time > KILL_WINDOW then
                        RecentSlaps[player] = nil
                        slap = nil
                    end
                    if not state.Handled and state.CheckDeath and (player == LocalPlayer or slap) then
                        local root = state.Root
                        if not root or not root.Parent then
                            local char = state.Character
                            root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char:FindFirstChild("Torso"))
                            state.Root = root
                        end
                        if root and root.Position.Y < -35 then
                            state.CheckDeath("Void(Y<-35)")
                        end
                    end
                end
            end
            task_wait(0.2)
        end
    end)

    local function syncLocalEquipped()
        pcall(function()
            local eq = LocalPlayer:FindFirstChild("Equipped")
            if not eq then
                eq = Instance.new("Folder")
                eq.Name = "Equipped"
                eq.Parent = LocalPlayer
            end
            local hitVal = eq:FindFirstChild("HitEffect")
            if not hitVal then
                hitVal = Instance.new("StringValue")
                hitVal.Name = "HitEffect"
                hitVal.Value = "_hitEffectDefault"
                hitVal.Parent = eq
            end
            local deathVal = eq:FindFirstChild("DeathEffect")
            if not deathVal then
                deathVal = Instance.new("StringValue")
                deathVal.Name = "DeathEffect"
                deathVal.Value = "_hitEffectDefault"
                deathVal.Parent = eq
            end
            local killVal = eq:FindFirstChild("KillEffect")
            if not killVal then
                killVal = Instance.new("StringValue")
                killVal.Name = "KillEffect"
                killVal.Value = "_hitEffectDefault"
                killVal.Parent = eq
            end
            local spawnVal = eq:FindFirstChild("SpawnEffect") or eq:FindFirstChild("Spawn")
            if not spawnVal then
                spawnVal = Instance.new("StringValue")
                spawnVal.Name = "SpawnEffect"
                spawnVal.Value = "_spawnEffectDefault"
                spawnVal.Parent = eq
            end
            if Controller.SelectedHitEffect then hitVal.Value = getEntryID(Controller.SelectedHitEffect) end
            if Controller.SelectedDeathEffect then deathVal.Value = getEntryID(Controller.SelectedDeathEffect) end
            if Controller.SelectedKillVisualEffect then killVal.Value = getEntryID(Controller.SelectedKillVisualEffect) end
            if Controller.SelectedSpawnEffect then spawnVal.Value = getEntryID(Controller.SelectedSpawnEffect) end
        end)
    end

    local localCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
        Controller.LastDeathTime = os.clock()
        table.clear(RecentSlaps)
        Controller.LastIncomingHitTime = -math.huge
        Controller.LastIncomingHitCharacter = nil
        Controller.LastCombatDeathVisualTime = -math.huge
        Controller.LastCharacterPosition = nil
        Controller.PendingArenaEntry = nil
        suppressCharacterVisuals(1.75, true)
        task_wait(0.5)
        syncLocalEquipped()
    end)
    table_insert(Controller.Connections, localCharacterConnection)
    syncLocalEquipped()
end
