SettingsTab:Button({
    Title = "Destroy Script",
    Desc = "Unhooks all events and removes UI",
    Callback = function()
        if Controller.RestoreNativeVFX then pcall(Controller.RestoreNativeVFX) end
        Controller.Destroyed = true
        Controller.Enabled = false
        Controller.ChangerActive = false
        for _, c in ipairs(Controller.Connections) do
            pcall(c.Disconnect, c)
        end
        table.clear(Controller.Connections)
        cleanupDeathWatchers()
        if resetSpecialEffects then
            resetSpecialEffects()
        end
        if Controller.SpawnFolder then
            Controller.SpawnFolder:Destroy()
        end
        if Window and Window.Destroy then
            pcall(Window.Destroy, Window)
        end
    end,
})

