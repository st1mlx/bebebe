local function preloadEntryAsync(entry)
    if not entry then return end
    local id = entry.ItemID

    -- Debounce quick selections. Selecting an item must remain O(1);
    -- deserialization/preload starts only after the UI callback has fully returned.
    Controller.PreloadGeneration = (Controller.PreloadGeneration or 0) + 1
    local generation = Controller.PreloadGeneration

    if Controller.PreloadedEffects[id] or Controller.PreloadInFlight[id] then return end

    task_delay(0.20, function()
        if Controller.Destroyed or generation ~= Controller.PreloadGeneration then return end
        if Controller.PreloadedEffects[id] or Controller.PreloadInFlight[id] then return end

        Controller.PreloadInFlight[id] = true
        local template = ensureEffectInstanceLoaded(entry)
        if template and not Controller.Destroyed then
            -- Batched and cooperative; does not preload the full hierarchy in one frame.
            if preloadAssetsAsync({ template }) then
                Controller.PreloadedEffects[id] = true
            end
        end
        Controller.PreloadInFlight[id] = nil
    end)
end

