        string.format("Death Effects (%d)", #Controller.CatalogHit),
        string.format("Kill Effects (%d)", #Controller.CatalogHit),
        string.format("Spawn Effects (%d)", #Controller.CatalogSpawn),
        string.format("Special Killstreaks (%d)", #Controller.CatalogKill),
    }
    local signature = table.concat(labels, "\0")
    if signature ~= categoryLabelSignature and Controller.CategoryDropdown and Controller.CategoryDropdown.Refresh then
        categoryLabels = labels
        categoryLabelSignature = signature
        pcall(Controller.CategoryDropdown.Refresh, Controller.CategoryDropdown, labels, false)
    end
end

