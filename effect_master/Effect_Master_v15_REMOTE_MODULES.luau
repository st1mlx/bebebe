local DropdownRenderState = setmetatable({}, { __mode = "k" })

local function getDisplayRevision(values)
    if values == Controller.HitDisplayStrings then
        return Controller.HitDisplayRevision
    elseif values == Controller.SpawnDisplayStrings then
        return Controller.SpawnDisplayRevision
    elseif values == Controller.KillDisplayStrings then
