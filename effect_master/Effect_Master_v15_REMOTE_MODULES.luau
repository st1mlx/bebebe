local function hookPortalDetector()
    local boundPortals = setmetatable({}, { __mode = "k" })
    local boundCount = 0

    local function isPortalPart(instance)
        if not instance or not instance:IsA("BasePart") then return false end
        local name = instance.Name:lower()
        return name:find("^teleport%d+$") ~= nil
            and not name:find("frame", 1, true)
            and not name:find("ramp", 1, true)
    end

    local function bindPortalTouch(portal)
        if not isPortalPart(portal) then return end
        if boundPortals[portal] then return end
        boundPortals[portal] = true
        boundCount = boundCount + 1
        local connection = portal.Touched:Connect(function(hit)
            if not Controller.ChangerActive or Controller.Destroyed then return end
            local character = LocalPlayer.Character
            if hit and character and hit:IsDescendantOf(character) then
                armArenaEntry()
            end
        end)
        table_insert(Controller.Connections, connection)
    end

    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then
        for _, descendant in ipairs(lobby:GetDescendants()) do
            bindPortalTouch(descendant)
        end
        table_insert(Controller.Connections, lobby.DescendantAdded:Connect(bindPortalTouch))
    end

    if boundCount == 0 then
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            bindPortalTouch(descendant)
        end
        table_insert(Controller.Connections, Workspace.DescendantAdded:Connect(bindPortalTouch))
    end

    local elapsedSinceCheck = 0
    local heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        elapsedSinceCheck = elapsedSinceCheck + deltaTime
        if elapsedSinceCheck < 0.08 then return end
        elapsedSinceCheck = 0
        if not Controller.ChangerActive or Controller.Destroyed then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local currentPos = hrp.Position
            local now = os.clock()
            local pending = Controller.PendingArenaEntry
            if pending then
                if pending.Character ~= char or now - pending.TouchedAt > 10 then
                    Controller.PendingArenaEntry = nil
                elseif now - Controller.LastDeathTime > 3.5 then
                    local movedFromPortal = (currentPos - pending.Origin).Magnitude > 150
                    local jumpedThisFrame = Controller.LastCharacterPosition
                        and (currentPos - Controller.LastCharacterPosition).Magnitude > 150
                    if movedFromPortal or jumpedThisFrame then
                        Controller.PendingArenaEntry = nil
                        onArenaEnter(char)
                    end
                end
            end
            if Controller.LastCharacterPosition then
                local fromX = Controller.LastCharacterPosition.X
                local toX = currentPos.X
                local dist = (currentPos - Controller.LastCharacterPosition).Magnitude
                if not pending and dist > 400 and fromX < -500 and toX > -400 and (now - Controller.LastPortalEnterTime > 3.0) and (now - Controller.LastDeathTime > 3.5) then
                    onArenaEnter(char)
                end
            end
            Controller.LastCharacterPosition = currentPos
        else
            Controller.LastCharacterPosition = nil
        end
    end)
    table_insert(Controller.Connections, heartbeatConnection)
end
