    return Controller.CatalogRevision
end

local function updateDropdown(dropdown, values, selectedDisplay, forceValues)
    if not dropdown then return end
    local state = DropdownRenderState[dropdown]
    if not state then
        state = {}
        DropdownRenderState[dropdown] = state
    end

    local revision = getDisplayRevision(values)
    if forceValues or state.Values ~= values or state.Revision ~= revision then
        if dropdown.Refresh then
            pcall(dropdown.Refresh, dropdown, values, false)
        elseif dropdown.SetValues then
            pcall(dropdown.SetValues, dropdown, values)
        end
        state.Values = values
        state.Revision = revision
    end

    if selectedDisplay and state.Selected ~= selectedDisplay and dropdown.Set then
        pcall(dropdown.Set, dropdown, selectedDisplay)
        state.Selected = selectedDisplay
    end
end

local function seedDropdownState(dropdown, values, selectedDisplay)
    if not dropdown then return end
    DropdownRenderState[dropdown] = {
        Values = values,
        Revision = getDisplayRevision(values),
        Selected = selectedDisplay,
    }
end

local function noteDropdownSelection(dropdown, selectedDisplay)
    local state = dropdown and DropdownRenderState[dropdown]
    if state then state.Selected = selectedDisplay end
end

