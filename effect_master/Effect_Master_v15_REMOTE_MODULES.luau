local EFFECT_MODULE_BASE = "https://raw.githubusercontent.com/st1mlx/bebebe/refs/heads/main/effect_master/modules/"

local function loadEffectModule(fileName)
    local url = EFFECT_MODULE_BASE .. fileName .. "?v=20260823v15"
    local source = game:HttpGet(url)
    assert(type(source) == "string" and #source > 40, "Module download failed: " .. fileName)
    local chunk, compileError = loadstring(source, "@" .. fileName)
    assert(chunk, "Module compile failed (" .. fileName .. "): " .. tostring(compileError))
    local ok, module = pcall(chunk)
    assert(ok, "Module runtime failed (" .. fileName .. "): " .. tostring(module))
    assert(type(module) == "table", "Module did not return a table: " .. fileName)
    return module
end

