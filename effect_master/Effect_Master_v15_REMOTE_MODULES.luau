local effectReportQueue = {}
local effectReportQueueHead = 1
local effectReportWorkerRunning = false
local effectReportsSent = {}
local effectReportsQueued = {}
local effectReportMarkerPath = "effect/discovery_sent_v13.txt"

local function safeEffectFileName(value)
    local safe = tostring(value or "effect"):gsub("[^%w%._%-]", "_")
    return safe:sub(1, 120)
end

local function ensureEffectCollectorFolders()
    if not hasFileSystem or type(isfolder) ~= "function" or type(makefolder) ~= "function" then
        return
    end
    for _, path in ipairs({ "effect", "effect/hit", "effect/spawn" }) do
        pcall(function()
            if not isfolder(path) then makefolder(path) end
        end)
    end
end

local function effectReportKey(category, id)
    return "FXS2V3\t" .. tostring(category) .. "\t" .. tostring(id)
end

local function loadEffectReportMarkers()
    ensureEffectCollectorFolders()
    if not hasFileSystem or not isfile(effectReportMarkerPath) then return end
    local ok, content = pcall(readfile, effectReportMarkerPath)
    if not ok or type(content) ~= "string" then return end
    for line in content:gmatch("[^\r\n]+") do
        if line ~= "" then effectReportsSent[line] = true end
    end
end

local function saveEffectReportMarker(key)
    effectReportsSent[key] = true
    if not hasFileSystem then return end
    pcall(function()
        local content = ""
        if isfile(effectReportMarkerPath) then
            content = readfile(effectReportMarkerPath) or ""
        end
        if content ~= "" and content:sub(-1) ~= "\n" then content = content .. "\n" end
        writefile(effectReportMarkerPath, content .. key .. "\n")
    end)
end

local function saveDiscoveredEffect(category, id, serialized)
    if not hasFileSystem then return end
    ensureEffectCollectorFolders()
    local subDirectory = category == "SpawnEffect" and "spawn" or "hit"
    local path = "effect/" .. subDirectory .. "/" .. safeEffectFileName(id)
    pcall(writefile, path, serialized)
end

local function sendEffectReport(item)
    if EFFECT_COLLECTOR_WEBHOOK == "" then return false, nil end

    local boundary = "------------------------" .. HttpService:GenerateGUID(false):gsub("%-", ""):sub(1, 20)
    local payload = HttpService:JSONEncode({
        username = "Slap Battles Effect Collector",
        allowed_mentions = { parse = {} },
        embeds = {{
            title = "New effect captured",
            description = string.format(
                "**Name:** `%s`\n**ID:** `%s`\n**Category:** `%s`\n**Rarity:** `%s`\n**Place:** `%s`\n**Job:** `%s`",
                tostring(item.Name):gsub("`", "'"),
                tostring(item.ID):gsub("`", "'"),
                tostring(item.Category):gsub("`", "'"),
                tostring(item.Rarity):gsub("`", "'"),
                tostring(game.PlaceId),
                (tostring(game.JobId):gsub("`", "'"))
            ),
            color = 0x00FFC8,
            footer = { text = "Effect Master discovery" },
        }},
    })
    local crlf = "\r\n"
    local fileName = safeEffectFileName(item.ID) .. ".txt"
    local body = table.concat({
        "--", boundary, crlf,
        "Content-Disposition: form-data; name=\"payload_json\"", crlf,
        "Content-Type: application/json", crlf, crlf,
        payload, crlf,
        "--", boundary, crlf,
        "Content-Disposition: form-data; name=\"files[0]\"; filename=\"", fileName, "\"", crlf,
        "Content-Type: text/plain", crlf, crlf,
        item.Serialized, crlf,
        "--", boundary, "--", crlf,
    })

    local response = httpRequest({
        Url = EFFECT_COLLECTOR_WEBHOOK,
        Method = "POST",
        Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
        Body = body,
    })
    if not response then return false, nil end

    local statusCode = tonumber(response.StatusCode or response.Status or response.status_code)
    if statusCode then return statusCode >= 200 and statusCode < 300, statusCode end
    return response.Success == true, nil
end

local startEffectReportWorker
local function queueEffectReport(item)
    local key = effectReportKey(item.Category, item.ID)
    if effectReportsSent[key] or effectReportsQueued[key] or Controller.Destroyed then return end
    effectReportsQueued[key] = true
    item.Key = key
    item.Attempts = item.Attempts or 0
    table_insert(effectReportQueue, item)
    startEffectReportWorker()
end

startEffectReportWorker = function()
    if effectReportWorkerRunning or Controller.Destroyed then return end
    effectReportWorkerRunning = true
    task_spawn(function()
        while not Controller.Destroyed do
            local item = effectReportQueue[effectReportQueueHead]
            if not item then break end
            effectReportQueue[effectReportQueueHead] = nil
            effectReportQueueHead = effectReportQueueHead + 1
            effectReportsQueued[item.Key] = nil

            local sent, statusCode = sendEffectReport(item)
            if sent then
                saveEffectReportMarker(item.Key)
            elseif item.Attempts < 5 then
                item.Attempts = item.Attempts + 1
                local retryDelay = statusCode == 429 and 10 or math.min(60, 2 ^ item.Attempts)
                task_delay(retryDelay, function()
                    if not Controller.Destroyed then queueEffectReport(item) end
                end)
            end
            task_wait(1.1)
        end

        if effectReportQueueHead > #effectReportQueue then
            effectReportQueue = {}
            effectReportQueueHead = 1
        end
        effectReportWorkerRunning = false
        if effectReportQueue[effectReportQueueHead] and not Controller.Destroyed then
            startEffectReportWorker()
        end
    end)
end

loadEffectReportMarkers()

local function registerReplicatedEffect(instance, defaultCategory)
    if not instance or Controller.Destroyed then return false end
    local id = instance.Name
    local lowerId = id:lower()
    local compactId = lowerId:gsub("[^%w]", "")
    local category = defaultCategory
    local displayName = cleanEffectName(id)
    local rarity = getEffectRarity(id)

    if compactId:find("staffrave", 1, true) then
        category = "KillEffect"
        displayName = "Staff Rave"
        rarity = "Special"
    elseif compactId:find("kittykatastrophe", 1, true) then
        category = "KillEffect"
        displayName = "Kitty Katastrophe"
        rarity = "Special"
    end

    local wasMissing = Controller.CatalogByID[id] == nil
    local existingSerialized = Controller.CloudCache[id]
    local hadSerialized = type(Serializer.isCurrentFormat) == "function"
        and Serializer.isCurrentFormat(existingSerialized)
    local serialized = nil

    if not hadSerialized and type(serializeInstance) == "function" then
        local ok, result = pcall(serializeInstance, instance)
        if ok and type(result) == "string" and result ~= "" and result ~= "nil" then
            serialized = result
        end
    end

    registerCatalogItem(category, id, displayName, rarity, instance, serialized)
    if serialized then
        saveDiscoveredEffect(category, id, serialized)
        queueEffectReport({
            ID = id,
            Name = displayName,
            Category = category,
            Rarity = rarity,
            Serialized = serialized,
        })
    end
    return wasMissing or serialized ~= nil
end

local function hookReplicatedEffectDiscovery()
    local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 10)
    if not assets then return end

    local folders = {
        { assets:FindFirstChild("HitEffects"), "HitEffect" },
        { assets:FindFirstChild("SpawnEffects"), "SpawnEffect" },
    }
    local changed = false
    for _, pair in ipairs(folders) do
        local folder, category = pair[1], pair[2]
        if folder then
            for index, instance in ipairs(folder:GetChildren()) do
                changed = registerReplicatedEffect(instance, category) or changed
                if index % 4 == 0 then task_wait() end
            end
            local connection = folder.ChildAdded:Connect(function(instance)
                if registerReplicatedEffect(instance, category) then
                    scheduleDiscoveredCatalogRefresh()
                end
            end)
            table_insert(Controller.Connections, connection)
        end
    end
    if changed then
        scheduleDiscoveredCatalogRefresh()
    end
end
task_spawn(hookReplicatedEffectDiscovery)

