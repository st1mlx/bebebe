local function onArenaEnter(expectedCharacter)
    local now = os.clock()
    if now - Controller.LastPortalEnterTime < 2.0 then return end
    if now - Controller.LastDeathTime < 3.5 then return end
    Controller.LastPortalEnterTime = now

    task_delay(0.12, function()
        if not Controller.ChangerActive or Controller.Destroyed then return end
        local char = LocalPlayer.Character
        if not char or (expectedCharacter and char ~= expectedCharacter) then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root then return end
        if now - (Controller.LastNativeSpawnEventTime or -math.huge) < 1 then return end
        local chosen = Controller.SelectedSpawnEffect
        if chosen and not isDefaultEntry(chosen, "Spawn") then
            local played = playSpawnEffectAction(chosen, char)
            if played then Controller.LastSpawnPlaybackTime = os.clock() end
        end
    end)
end

